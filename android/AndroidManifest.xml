<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- LAN play: local addresses and whether a network exists -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WifiManager, for the Wi-Fi and multicast locks -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Broadcast datagrams of the game search are dropped by many Wi-Fi chips without the multicast lock -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- The Wi-Fi lock and the CPU lock that keep a hosted game's turns going with the screen off -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The session service keeps the process and its network thread alive while the app is in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: the service notification; the service runs when it is denied -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Android 6 to 10: the shared profiles folder and a content folder outside the app's own folder -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:requestLegacyExternalStorage="true"
        android:name=".WarsmashApplication"
        android:allowBackup="false"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        android:isGame="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
        <activity
            android:name=".DataFolderActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>
        <activity
            android:name=".LauncherActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".MovieActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" />
        <service
            android:name=".LanSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a local network game connected while the app is in the background" />
        </service>
        <!-- The share sheet reads a crash log through this; nothing else is served -->
        <provider
            android:name=".CrashLogProvider"
            android:authorities="${applicationId}.crashlogs"
            android:exported="false"
            android:grantUriPermissions="true" />
        <!-- The system installer reads a downloaded update through this when the in-app install is refused -->
        <provider
            android:name=".UpdateApkProvider"
            android:authorities="${applicationId}.updateapk"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".AndroidLauncher"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:screenOrientation="sensorLandscape" />
    </application>

</manifest>
